# === Временные и системные файлы Adobe ===
*.idlk        # Блокирующие файлы InDesign (появляются, когда документ открыт)
*.tmp         # Временные файлы
*.bak         # Бэкапы
.DS_Store     # Системные файлы macOS (если работаете на Mac)
Thumbs.db     # Эскизы Windows (актуально для папок с графикой)

# === Ваша рабочая "песочница" и медиа ===
# Игнорируем папку с вашими тестами, видео и скриншотами
_temp/
captures/
recordings/
tests/samples/

# === Специфика разработки (скрипты) ===
# Если используете VS Code для написания JSX
.vscode/
*.log

# === Тяжелые исходники (если они не должны быть в репозитории) ===
# Например, если вы храните огромные PDF или оригиналы каталогов рядом
*.pdf
*.indb
*.idml
# Можно закомментировать строку ниже, если .indd файлы ДОЛЖНЫ быть в гите
# *.indd 

# === Архивы ===
*.zip
*.rar
*.7z